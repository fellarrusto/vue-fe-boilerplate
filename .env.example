# ─────────────────────────────────────────────────────────────
# Copia questo file in `.env` e valorizza le variabili.
# Solo le variabili con prefisso VITE_ arrivano al browser.
# ─────────────────────────────────────────────────────────────

# Nome applicazione (topbar, <title>, login)
VITE_APP_NAME=Vue Boilerplate

# Base URL delle API. In locale puoi usare /api e valorizzare VITE_PROXY_TARGET
VITE_API_URL=http://localhost:3000/api/v1

# Se valorizzato, Vite fa da proxy su /api verso questo host (evita CORS in dev)
# VITE_PROXY_TARGET=https://api.example.com

# ─── Auth ────────────────────────────────────────────────────
# true  = login finto in locale, nessun Firebase, nessun backend
# false = login reale Google + Firebase
VITE_MOCK_AUTH=true

# true = i service usano dati finti in memoria invece delle API reali
VITE_MOCK_API=true

# Firebase (obbligatori se VITE_MOCK_AUTH=false)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Google Identity Services client id (obbligatorio se VITE_MOCK_AUTH=false)
VITE_GOOGLE_CLIENT_ID=
